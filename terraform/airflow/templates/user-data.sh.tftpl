#!/bin/bash
set -euo pipefail

# Docker is the only thing this instance needs installed -- no uv/Python/git.
# cd-etl's image bundles its own dependencies, DAG code, and migrations
# (both Airflow's own and cd-etl's alembic ones), applied automatically by
# its entrypoint on every container start. The AWS CLI v2 is already
# preinstalled on the AL2023 base AMI, so it's not in this list (there's no
# "aws-cli" dnf package on AL2023 to install it from). postgresql16
# (matching rds/'s engine_version) provides the psql client used by the
# one-time bootstrap below -- confirmed present in AL2023's default repos.
dnf install -y docker jq postgresql16
systemctl enable --now docker

# AL2023 has no "docker-compose-plugin" dnf package at all (confirmed --
# `dnf install` fails outright on that name, which as a bonus confirms dnf
# treats a multi-package install as all-or-nothing: nothing else in that
# command would have installed either). Compose v2 isn't in AL2023's repos
# under any name, so install it the way AWS's own docs do: download the
# CLI plugin binary directly from its GitHub release, matching this
# instance's architecture via `uname -m` (x86_64 -- see main.tf's AMI/
# instance_type comments for why this isn't arm64/Graviton).
mkdir -p /usr/libexec/docker/cli-plugins
curl -SL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-$(uname -m)" \
  -o /usr/libexec/docker/cli-plugins/docker-compose
chmod +x /usr/libexec/docker/cli-plugins/docker-compose

REGION="${aws_region}"

# No static credentials anywhere -- fetched via this instance's own IAM
# role (see main.tf's aws_iam_role_policy.airflow_instance).
CONGRESS_API_KEY=$(aws secretsmanager get-secret-value --region "$REGION" \
  --secret-id "${congress_api_key_secret_arn}" --query SecretString --output text)
RDS_SECRET=$(aws secretsmanager get-secret-value --region "$REGION" \
  --secret-id "${rds_master_secret_arn}" --query SecretString --output text)
RDS_USER=$(echo "$RDS_SECRET" | jq -r .username)
RDS_PASS=$(echo "$RDS_SECRET" | jq -r .password)

CD_ETL_APP_SECRET=$(aws secretsmanager get-secret-value --region "$REGION" \
  --secret-id "${cd_etl_app_db_secret_arn}" --query SecretString --output text)
CD_ETL_APP_USER=$(echo "$CD_ETL_APP_SECRET" | jq -r .username)
CD_ETL_APP_PASS=$(echo "$CD_ETL_APP_SECRET" | jq -r .password)
# URL-encode before interpolating into the connection URI below -- RDS's
# managed-password generator doesn't guarantee excluding every
# URI-significant character (e.g. ":"), and an unescaped one would
# silently corrupt the connection string.
CD_ETL_APP_USER_ENC=$(jq -rn --arg s "$CD_ETL_APP_USER" '$s|@uri')
CD_ETL_APP_PASS_ENC=$(jq -rn --arg s "$CD_ETL_APP_PASS" '$s|@uri')

# One-time, idempotent bootstrap (safe to re-run on every boot) using the
# RDS master/superuser credentials -- creates the airflow_metadata database
# (RDS has no docker-entrypoint-initdb.d equivalent) and a scoped
# least-privilege role for cd-etl/Airflow's own ongoing traffic. The master
# credentials are used only here, never written to the .env file below or
# exposed to cd-etl's container.
#
# format()'s %L already quotes the password safely, so this avoids `DO $$
# ... $$` PL/pgSQL blocks entirely -- bash would expand an unescaped `$$`
# in a heredoc to its own PID, corrupting Postgres's dollar-quoting syntax.
export PGPASSWORD="$RDS_PASS"
psql -h ${rds_address} -U "$RDS_USER" -d postgres -v ON_ERROR_STOP=1 <<-SQL
SELECT 'CREATE DATABASE ${airflow_metadata_db_name}'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '${airflow_metadata_db_name}')\gexec

SELECT format('CREATE ROLE %I LOGIN PASSWORD %L', '${cd_etl_db_username}', '$CD_ETL_APP_PASS')
WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '${cd_etl_db_username}')\gexec

ALTER ROLE "${cd_etl_db_username}" WITH PASSWORD '$CD_ETL_APP_PASS';
SQL

for db in cd_platform ${airflow_metadata_db_name}; do
  psql -h ${rds_address} -U "$RDS_USER" -d "$db" -v ON_ERROR_STOP=1 <<-SQL
GRANT ALL PRIVILEGES ON DATABASE "$db" TO "${cd_etl_db_username}";
GRANT ALL ON SCHEMA public TO "${cd_etl_db_username}";
SQL
done
unset PGPASSWORD

mkdir -p /opt/airflow

# db name here ("cd_platform") matches rds/main.tf's aws_db_instance.this
# db_name -- NOT local dev's docker-compose.yml, which uses
# "congressional_app" for the same role (a known, pre-existing naming
# difference between this repo and cd-platform's local dev). Connects as
# the scoped role created above, never the RDS master user.
cat > /opt/airflow/.env <<EOF
CONGRESS_API_KEY=$CONGRESS_API_KEY
AIRFLOW_CONN_CONGRESSIONAL_POSTGRES=postgresql://$${CD_ETL_APP_USER_ENC}:$${CD_ETL_APP_PASS_ENC}@${rds_address}:5432/cd_platform
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://$${CD_ETL_APP_USER_ENC}:$${CD_ETL_APP_PASS_ENC}@${rds_address}:5432/${airflow_metadata_db_name}
EOF
chmod 600 /opt/airflow/.env

# cd-etl's GHCR package is public, so both cd-etl's image pull and
# watchtower's polling work anonymously -- no docker login/PAT needed.
cat > /opt/airflow/docker-compose.yml <<EOF
services:
  cd-etl:
    # Must be the mutable "latest" tag, not a "vX.X.X" one -- watchtower
    # tracks a single tag/digest per container and has no semver awareness
    # to compare across differently-named version tags, so it can only
    # detect new releases by polling the tag it's already watching.
    image: ${ghcr_image}:latest
    restart: unless-stopped
    env_file: .env
    # Published so SSM port-forwarding (see terraform/README.md) has
    # something listening on the host side to forward to.
    ports:
      - "8080:8080"
    labels:
      - "com.centurylinklabs.watchtower.enable=true"
    # Caps json-file log growth -- Airflow's own logs plus container
    # stdout/stderr have no other size limit on this instance's small
    # root volume (watchtower's --cleanup below only prunes old images,
    # not logs).
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  watchtower:
    image: containrrr/watchtower
    restart: unless-stopped
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    # --label-enable scopes watchtower to only the cd-etl service above, so
    # it never tries to update itself or any other container on this host.
    # --cleanup removes the superseded image after each update -- without
    # it, old cd-etl layers accumulate indefinitely on this instance's
    # small (AMI-default) root volume.
    command: --label-enable --cleanup --interval 300
EOF

# Compose's own "restart: unless-stopped" already covers daemon/container
# crash recovery. This unit's job is specifically to re-run
# `docker compose up -d` on a full instance reboot.
cat > /etc/systemd/system/airflow-cd-etl.service <<EOF
[Unit]
Description=cd-etl + watchtower (docker compose)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/airflow
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now airflow-cd-etl.service
