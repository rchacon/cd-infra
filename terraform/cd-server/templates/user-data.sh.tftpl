#!/bin/bash
set -euo pipefail

# The ECS-optimized AL2023 AMI ships with the ECS agent and Docker
# preinstalled, so there's nothing to install for either. This has two
# jobs: (1) tell the ECS agent which cluster to join, and (2) the same
# idempotent RDS bootstrap ../airflow's and ../airflow-ecs's user-data
# scripts do, scoped to cd-server's own cd_customers database.

# Deliberately first and unconditional, before anything that touches the
# network/RDS -- under `set -euo pipefail`, a transient failure in the
# bootstrap below (RDS not yet reachable, SG propagation delay, a
# get-secret-value hiccup) would abort the script before a later
# ECS_CLUSTER write ever ran, leaving the instance looking healthy in the
# ASG while the ECS agent never registers with the cluster and no task
# ever gets placed on it -- with no obvious error outside cloud-init logs.
# Writing this first means that failure mode is independent: even if the
# RDS bootstrap below fails, the instance still joins the cluster.
echo "ECS_CLUSTER=${ecs_cluster_name}" >> /etc/ecs/ecs.config

dnf install -y jq postgresql16

REGION="${aws_region}"

# No static credentials anywhere -- fetched via this instance's own IAM
# role (see main.tf's aws_iam_role_policy.ecs_instance_bootstrap).
RDS_SECRET=$(aws secretsmanager get-secret-value --region "$REGION" \
  --secret-id "${rds_master_secret_arn}" --query SecretString --output text)
RDS_USER=$(echo "$RDS_SECRET" | jq -r .username)
RDS_PASS=$(echo "$RDS_SECRET" | jq -r .password)

CD_SERVER_APP_SECRET=$(aws secretsmanager get-secret-value --region "$REGION" \
  --secret-id "${cd_server_app_db_secret_arn}" --query SecretString --output text)
CD_SERVER_APP_PASS=$(echo "$CD_SERVER_APP_SECRET" | jq -r .password)

# One-time, idempotent bootstrap (safe to re-run on every boot) using the
# RDS master/superuser credentials -- creates the cd_customers database
# (RDS has no docker-entrypoint-initdb.d equivalent) and a scoped
# least-privilege role for cd-server's own ongoing traffic. The master
# credentials are used only here, never handed to cd-server's container
# (which connects as the scoped role below via the task definition's own
# `secrets` block).
#
# format()'s %L already quotes the password safely, so this avoids `DO $$
# ... $$` PL/pgSQL blocks entirely -- bash would expand an unescaped `$$`
# in a heredoc to its own PID, corrupting Postgres's dollar-quoting
# syntax.
export PGPASSWORD="$RDS_PASS"
psql -h ${rds_address} -U "$RDS_USER" -d postgres -v ON_ERROR_STOP=1 <<-SQL
SELECT 'CREATE DATABASE ${cd_customers_db_name}'
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '${cd_customers_db_name}')\gexec

SELECT format('CREATE ROLE %I LOGIN PASSWORD %L', '${cd_server_db_username}', '$CD_SERVER_APP_PASS')
WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '${cd_server_db_username}')\gexec

ALTER ROLE "${cd_server_db_username}" WITH PASSWORD '$CD_SERVER_APP_PASS';
SQL

psql -h ${rds_address} -U "$RDS_USER" -d "${cd_customers_db_name}" -v ON_ERROR_STOP=1 <<-SQL
GRANT ALL PRIVILEGES ON DATABASE "${cd_customers_db_name}" TO "${cd_server_db_username}";
GRANT ALL ON SCHEMA public TO "${cd_server_db_username}";
SQL
unset PGPASSWORD
